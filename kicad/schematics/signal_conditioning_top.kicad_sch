	(title_block
		(title "Audio AFE Top Level Structure")
		(date "2026-09-03")
		(rev "AA")
		(company "By Omar Othman")
	)
	(lib_symbols)
	(text "NOTES\n \nAll opamps powered from ±12 V rails for max headroom\nDriver designed for compatibility with AD4695 / CS5312class ADCs\nFinal analog bandwidth ≈ 15 kHz (audio-band)\nV+ mic+ 0 {V(mic_cm) + V(mic_diff)/2}\nV- mic- 0 {V(mic_cm) - V(mic_diff)/2}\n \nDesign Target = 100dB CMRR"
		(exclude_from_sim no)
		(at 147.574 99.314 0)
		(effects
			(font
				(face "Arial Black")
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "5827cdb0-4602-42bd-94b5-490e5792ea4f")
	)
	(text "Project Specs\n\nBalanced mic input with\n- RF filtering\n- ESD protection\n- INA163 instrumentation amplifier providing +40 dB gain.\n \nIN0 driven by conditioned AFE output (ADC_IN, low‑Z, ~1 VRMS max)"
		(exclude_from_sim no)
		(at 143.256 52.07 0)
		(effects
			(font
				(face "Arial Black")
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "972b1b9c-6f1d-4d6d-9266-ae63d6dbbb77")
	)
